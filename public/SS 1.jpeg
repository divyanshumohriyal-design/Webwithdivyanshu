<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="100%" height="100%">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap');
      .font-display { font-family: 'Barlow Condensed', 'Plus Jakarta Sans', Impact, sans-serif; }
      .font-body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; }
    </style>
    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.1" />
    </filter>
    <clipPath id="heroImgClip">
      <rect width="530" height="520" rx="24" />
    </clipPath>
  </defs>

  <!-- Clean Canvas (#FAFAF8) -->
  <rect width="1280" height="720" fill="#FAFAF8" />

  <!-- ================= TOP NAVIGATION BAR ================= -->
  <g class="font-body" transform="translate(50, 20)">
    <!-- Red Flame Logo -->
    <rect width="36" height="36" rx="10" fill="#E63946" />
    <path d="M18 8 C19 13, 25 16, 25 21 C25 25.5, 21.5 29, 18 29 C14.5 29, 11 25.5, 11 21 C11 16, 17 13, 18 8 Z" fill="#FFFFFF" />
    <path d="M18 15 C18.5 18, 21.5 20, 21.5 23 C21.5 25, 20 26.5, 18 26.5 C16 26.5, 14.5 25, 14.5 23 C14.5 20, 17.5 18, 18 15 Z" fill="#E63946" />

    <text x="48" y="20" font-size="16" font-weight="900" fill="#171717" letter-spacing="0.05em">IRONFORGE FITNESS</text>
    <text x="48" y="32" font-size="9" font-weight="700" fill="#5F6368" letter-spacing="0.14em">STRENGTH &amp; DISCIPLINE</text>

    <!-- Nav Links -->
    <g font-size="13" font-weight="600" fill="#5F6368">
      <text x="380" y="24" fill="#E63946" font-weight="700">Home</text>
      <rect x="380" y="30" width="36" height="2" rx="1" fill="#E63946" />

      <text x="446" y="24">About</text>
      <text x="510" y="24">Programs</text>
      <text x="595" y="24">Trainers</text>
      <text x="675" y="24">Facilities</text>
      <text x="755" y="24">Membership</text>
      <text x="865" y="24">Schedule</text>
      <text x="950" y="24">Contact</text>
    </g>

    <!-- Phone -->
    <g transform="translate(1020, 14)">
      <text x="0" y="7" font-size="9" font-weight="600" fill="#5F6368">+91</text>
      <text x="0" y="18" font-size="11" font-weight="700" fill="#171717">98765 43210</text>
    </g>

    <!-- Sign In -->
    <g transform="translate(1100, 18)">
      <path d="M0 6 L10 6 M7 3 L10 6 L7 9" stroke="#5F6368" stroke-width="1.5" fill="none" stroke-linecap="round" />
      <text x="16" y="9" font-size="11" font-weight="700" fill="#171717">SIGN IN</text>
    </g>

    <!-- Free 1-Day Pass -->
    <g transform="translate(1170, 0)">
      <rect width="70" height="44" rx="8" fill="#E63946" />
      <text x="35" y="16" font-size="9" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.06em">FREE</text>
      <text x="35" y="27" font-size="9" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.06em">1-DAY</text>
      <text x="35" y="37" font-size="8.5" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.06em">PASS</text>
    </g>
  </g>

  <!-- ================= LEFT HERO CONTENT ================= -->
  <g transform="translate(50, 105)">
    <!-- Category Pill Badge -->
    <g class="font-body">
      <rect width="226" height="30" rx="15" fill="#FEE2E2" />
      <path d="M16 8 C16.6 11, 20 13, 20 16 C20 19, 18 21, 16 21 C14 21, 12 19, 12 16 C12 13, 15.4 11, 16 8 Z" fill="#E63946" />
      <text x="28" y="19.5" font-size="10.5" font-weight="800" fill="#E63946" letter-spacing="0.08em">PREMIUM FITNESS EXPERIENCE</text>
    </g>

    <!-- Main Headline (Authentic Barlow Condensed Athletic Typo) -->
    <g class="font-display" transform="translate(0, 72)">
      <text x="0" y="0" font-size="74" font-weight="900" fill="#171717" letter-spacing="-0.01em">
        BUILD THE <tspan fill="#E63946">BODY.</tspan>
      </text>
      <text x="0" y="72" font-size="74" font-weight="900" fill="#171717" letter-spacing="-0.01em">
        BUILD THE MIND.
      </text>
      <!-- Squiggly wavy underline under MIND -->
      <path d="M415 82 Q 420 78, 425 82 T 435 82 T 445 82 T 455 82 T 465 82 T 475 82 T 485 82 T 495 82 T 505 82 T 515 82 T 525 82 T 535 82 T 545 82 T 555 82" fill="none" stroke="#E63946" stroke-width="3" stroke-linecap="round" opacity="0.6" />
    </g>

    <!-- Paragraph Description -->
    <g class="font-body" transform="translate(0, 235)">
      <text x="0" y="0" font-size="15.5" font-weight="400" fill="#5F6368">
        <tspan x="0" dy="0">Train smarter, get stronger, and become the strongest</tspan>
        <tspan x="0" dy="25">version of yourself with expert coaching, premium</tspan>
        <tspan x="0" dy="25">equipment, and a community built around results.</tspan>
      </text>
    </g>

    <!-- Call to Action Buttons -->
    <g class="font-body" transform="translate(0, 335)">
      <!-- Primary Button -->
      <g>
        <rect width="240" height="52" rx="12" fill="#E63946" filter="url(#cardShadow)" />
        <text x="32" y="32" font-size="13.5" font-weight="800" fill="#FFFFFF" letter-spacing="0.06em">START YOUR JOURNEY</text>
        <path d="M196 26 L208 26 M204 22 L208 26 L204 30" stroke="#FFFFFF" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </g>

      <!-- Secondary Button -->
      <g transform="translate(256, 0)">
        <rect width="190" height="52" rx="12" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1" />
        <text x="95" y="32" font-size="12.5" font-weight="800" fill="#171717" text-anchor="middle" letter-spacing="0.06em">EXPLORE PROGRAMS</text>
      </g>
    </g>

    <!-- Stat Counters -->
    <g transform="translate(0, 435)">
      <g transform="translate(0, 0)">
        <text x="0" y="0" class="font-display" font-size="38" font-weight="900" fill="#171717">500<tspan fill="#E63946">+</tspan></text>
        <text x="0" y="22" class="font-body" font-size="10.5" font-weight="700" fill="#5F6368" letter-spacing="0.08em">ACTIVE MEMBERS</text>
      </g>

      <g transform="translate(185, 0)">
        <line x1="-20" y1="-25" x2="-20" y2="25" stroke="#E5E7EB" stroke-width="1" />
        <text x="0" y="0" class="font-display" font-size="38" font-weight="900" fill="#171717">15<tspan fill="#E63946">+</tspan></text>
        <text x="0" y="22" class="font-body" font-size="10.5" font-weight="700" fill="#5F6368" letter-spacing="0.08em">EXPERT TRAINERS</text>
      </g>

      <g transform="translate(370, 0)">
        <line x1="-20" y1="-25" x2="-20" y2="25" stroke="#E5E7EB" stroke-width="1" />
        <text x="0" y="0" class="font-display" font-size="38" font-weight="900" fill="#171717">8<tspan fill="#E63946">+</tspan></text>
        <text x="0" y="22" class="font-body" font-size="10.5" font-weight="700" fill="#5F6368" letter-spacing="0.08em">YEARS EXPERIENCE</text>
      </g>
    </g>
  </g>

  <!-- ================= RIGHT HERO VISUAL (AUTHENTIC GYM PHOTO EMBEDDED) ================= -->
  <g transform="translate(690, 105)">
    <!-- Image Card Container -->
    <g filter="url(#cardShadow)">
      <rect width="530" height="520" rx="24" fill="#18181b" stroke="#E5E7EB" stroke-width="1" />
      
      <!-- REAL GYM PHOTOGRAPH FROM THE LIVE SITE -->
      <g clip-path="url(#heroImgClip)">
        <image href="data:image/jpeg;base64," width="530" height="520" preserveAspectRatio="xMidYMid slice" />
        <!-- Bottom Vignette Gradient Overlay -->
        <rect y="280" width="530" height="240" fill="url(#bottomGrad)" opacity="0.75" />
      </g>
    </g>

    <defs>
      <linearGradient id="bottomGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#000000" stop-opacity="0" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0.7" />
      </linearGradient>
    </defs>

    <!-- Floating Badge Top Left: '8+ YEARS PROVEN RESULTS' -->
    <g class="font-body" transform="translate(-15, -12)">
      <rect width="175" height="62" rx="16" fill="#FFFFFF" filter="url(#cardShadow)" stroke="#E5E7EB" stroke-width="1" />
      <!-- Medal Icon -->
      <g transform="translate(14, 14)">
        <rect width="34" height="34" rx="10" fill="#FFF7ED" stroke="#FED7AA" stroke-width="1" />
        <path d="M17 10 L19 14.5 L24 14.5 L20 17.5 L22 22 L17 19.5 L12 22 L14 17.5 L10 14.5 L15 14.5 Z" fill="#F97316" />
      </g>
      <text x="58" y="31" class="font-display" font-size="20" font-weight="900" fill="#171717">8+ YEARS</text>
      <text x="58" y="46" class="font-body" font-size="9" font-weight="800" fill="#5F6368" letter-spacing="0.08em">PROVEN RESULTS</text>
    </g>

    <!-- Floating Banner Bottom: 'DEHRADUN'S ELITE FACILITY' -->
    <g class="font-body" transform="translate(20, 424)">
      <rect width="490" height="72" rx="18" fill="#FFFFFF" opacity="0.98" filter="url(#cardShadow)" stroke="#E5E7EB" stroke-width="1" />
      
      <!-- Red Trophy Icon Box -->
      <g transform="translate(14, 14)">
        <rect width="44" height="44" rx="12" fill="#E63946" />
        <path d="M14 11 L30 11 L30 18 C30 24, 25 28, 22 28 C19 28, 14 24, 14 18 Z" fill="#FFFFFF" />
        <path d="M11 14 C11 18, 14 19, 14 19" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round" />
        <path d="M33 14 C33 18, 30 19, 30 19" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round" />
        <rect x="20.5" y="28" width="3" height="5" fill="#FFFFFF" />
        <rect x="17" y="33" width="10" height="2.5" rx="1" fill="#FFFFFF" />
      </g>

      <!-- Facility Text -->
      <g transform="translate(70, 0)">
        <text x="0" y="34" font-size="12.5" font-weight="900" fill="#171717" letter-spacing="0.06em">DEHRADUN'S ELITE FACILITY</text>
        <text x="0" y="50" font-size="10.5" font-weight="500" fill="#5F6368">World-Class Strength &amp; Conditioning</text>
      </g>

      <!-- 'OPEN TODAY' Green Pill -->
      <g transform="translate(390, 22)">
        <rect width="84" height="28" rx="8" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="1" />
        <circle cx="14" cy="14" r="3.5" fill="#059669" />
        <text x="24" y="18" font-size="9" font-weight="800" fill="#047857" letter-spacing="0.06em">OPEN TODAY</text>
      </g>
    </g>
  </g>

  <!-- Bottom Netlify & Discover Links -->
  <g class="font-body" transform="translate(560, 692)">
    <text x="0" y="0" font-size="9.5" font-weight="800" fill="#9CA3AF" letter-spacing="0.12em">DISCOVER IRONFORGE</text>
    <path d="M74 5 L78 9 L82 5" stroke="#9CA3AF" stroke-width="1.5" fill="none" stroke-linecap="round" />
  </g>

  <g class="font-body" transform="translate(1120, 682)">
    <rect width="115" height="24" rx="6" fill="#09090b" opacity="0.9" />
    <path d="M10 12 L14 8 L18 12 L14 16 Z" fill="#00C7B7" />
    <text x="24" y="15" font-size="9" font-weight="600" fill="#D4D4D8">Powered by <tspan font-weight="800" fill="#FFFFFF">Netlify</tspan></text>
  </g>
</svg>